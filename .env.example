# ── 장비 연결 ─────────────────────────────────────────────
# mock  : 반주기·카메라·RF 리더를 브라우저 안에서 흉내냅니다 (기본값, 시연용)
# local : 기기에 설치된 로컬 에이전트(ws://127.0.0.1:7700)에 연결합니다
NEXT_PUBLIC_AGENT_MODE=mock
NEXT_PUBLIC_AGENT_URL=ws://127.0.0.1:7700

# ── 서버 API ─────────────────────────────────────────────
# mock : 회원·포인트·AI 작업을 메모리에서 흉내냅니다 (기본값)
# http : NEXT_PUBLIC_API_BASE 의 MUVIS 통합 서버를 호출합니다
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE=https://api.muvis.example.com/v1

# QR 코드가 가리킬 MUVIS 모바일 웹 주소
NEXT_PUBLIC_MOBILE_WEB_URL=https://m.muvis.example.com

# URL에 ?booth= 가 없을 때 쓸 부스 ID
NEXT_PUBLIC_BOOTH_ID=DEMO-BOOTH-01

# 시연용 개발 패널 (로고를 2초간 누르면 열림). 모의 서버(mock)에서는 기본으로 켜짐. 운영 배포에서는 false
NEXT_PUBLIC_DEV_PANEL=true

# 시연 모드 소리 (반주·가이드 멜로디·마이크 에코). 끄려면 false
NEXT_PUBLIC_DEMO_AUDIO=true
# 마이크 원음 모드: 지연은 줄지만 노트북 스피커에서는 하울링이 날 수 있음 (믹서 경유 매장 마이크용)
NEXT_PUBLIC_MIC_RAW=false

# USB RF 리더(키보드처럼 카드번호+Enter를 입력하는 방식) 입력 받기
NEXT_PUBLIC_RF_KEYBOARD=true

# 모의 반주 1곡 길이(초). 실제 곡 길이보다 짧게 잘라 시연합니다
NEXT_PUBLIC_DEMO_SONG_SECONDS=40

# ── AR 가면 ──────────────────────────────────────────────
# 모의 장비의 CAM 1에 키오스크 웹캠을 써서 내 얼굴에 가면이 씌워지는 걸 시연 (false면 실루엣)
NEXT_PUBLIC_MOCK_WEBCAM=true
# 얼굴 인식 모델·WASM 위치. 인터넷이 불안정한 매장은 public/mediapipe/ 에 복사해 두고 경로를 바꾸세요
# NEXT_PUBLIC_AR_WASM_BASE=/mediapipe/wasm
# NEXT_PUBLIC_AR_MODEL_URL=/mediapipe/face_landmarker.task
# 동시에 가면을 씌울 최대 인원 (듀엣 2)
NEXT_PUBLIC_AR_MAX_FACES=2
